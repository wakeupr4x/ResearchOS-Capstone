# ==============================================
# ResearchOS Environment Configuration
# ==============================================

# Database
# For immediate local zero-dependency development, SQLite vector fallback is enabled by default:
DATABASE_URL=sqlite:///./data/researchos.db
# For production PostgreSQL + pgvector (e.g. docker-compose):
# DATABASE_URL=postgresql://researchos:researchos_secret@localhost:5432/researchos

# AI & LLM Provider (gemini, openai, or fallback)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Embeddings (Sentence-Transformers runs locally & offline without API keys)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage
STORAGE_PROVIDER=local
STORAGE_DIR=./data/storage
UPLOAD_DIR=./data/uploads

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEBUG=True
